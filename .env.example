# Application
APP_NAME=Centre d'aide
APP_URL=http://localhost:8000
SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-SECRET
ENVIRONMENT=development

# Authentification : oidc (défaut), both (OIDC + compte admin local), local (sans OIDC)
AUTH_MODE=oidc
LOCAL_ADMIN_USERNAME=faqadmin
# À définir avec au moins 14 caractères si AUTH_MODE=both ou local au premier démarrage.
# Supprimer la valeur du .env après création du compte (le hash reste en base).
LOCAL_ADMIN_PASSWORD=
SEED_DEMO=true

# PostgreSQL
POSTGRES_DB=faqdb
POSTGRES_USER=faquser
POSTGRES_PASSWORD=CHANGE-ME-STRONG-PASSWORD
DATABASE_URL=postgresql+psycopg://faquser:CHANGE-ME-STRONG-PASSWORD@db:5432/faqdb

# OIDC (Authentik ou Keycloak)
OIDC_DISCOVERY_URL=https://auth.example.com/application/o/faq/.well-known/openid-configuration
OIDC_CLIENT_ID=faq-portal
OIDC_CLIENT_SECRET=CHANGE-ME
OIDC_SCOPES=openid profile email
OIDC_BUTTON_LABEL=Connexion entreprise

# Admin : au moins une adresse e-mail ou un groupe OIDC
ADMIN_EMAILS=admin@example.com
ADMIN_GROUPS=faq-admins

# Branding initial
BRAND_NAME=Centre d'aide
BRAND_TAGLINE=Les réponses utiles, simplement.
BRAND_COLOR=#3157a4
BRAND_LOGO_URL=

# Statistiques d'usage (pseudonymisées)
ANALYTICS_ENABLED=true
# Demander le consentement avant toute mesure de fréquentation.
ANALYTICS_REQUIRE_CONSENT=true
# Claim OIDC contenant le service ou la direction (à mapper dans Authentik / Keycloak).
ANALYTICS_SERVICE_CLAIM=department
# Sel HMAC dédié, stable dans le temps (générer avec : openssl rand -hex 32).
ANALYTICS_SALT=CHANGE-ME-WITH-A-LONG-RANDOM-VALUE
ANALYTICS_RETENTION_DAYS=365

# Intégration GLPI 11.0.11+ : clé dédiée au plugin GLPI (openssl rand -hex 32)
# Laisser vide pour désactiver l'API d'intégration. Ne jamais exposer cette clé au navigateur.
GLPI_API_TOKEN=
GLPI_API_MAX_RESULTS=8

# Existing Docker network shared with your reverse proxy
PROXY_NETWORK=reverse-proxy
